{
  "name": "watchparty",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "cd ./app/client/; bun run dev",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --watch ./app/server/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^10.0.5",
    "google-auth-library": "^11.0.2",
    "googleapis": "^176.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}